# Supabase / PostgreSQL connection
# Usar el POOLER de Supabase (IPv4). El host directo db.[REF].supabase.co:5432 no resuelve en IPv4.
# Despliegues persistentes (Render, Railway, Fly.io) → session pooler, puerto 5432:
#   DATABASE_URL="postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Alternativa transaction pooler (puerto 6543), solo para conexiones cortas:
#   DATABASE_URL="postgresql://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your-jwt-secret-change-me"
JWT_EXPIRATION="24h"

# App
PORT=3001
NODE_ENV=development

# Orígenes permitidos para CORS (lista separada por comas).
# En desarrollo alcanza con los defaults de localhost.
# En producción agregar el dominio del frontend, ej:
# CORS_ORIGINS="https://club-deportivo-phi.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"