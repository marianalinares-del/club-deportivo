# Supabase / PostgreSQL connection
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT
JWT_SECRET="your-jwt-secret-change-me"
JWT_EXPIRATION="24h"

# App
PORT=3001
NODE_ENV=development

# Orígenes permitidos para CORS (lista separada por comas).
# En desarrollo alcanza con los defaults de localhost.
# En producción agregar el dominio del frontend, ej:
# CORS_ORIGINS="https://club-deportivo-phi.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"